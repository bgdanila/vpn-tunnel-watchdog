{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.12" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)",        "dest": "/api/index.py" }
  ],
  "env": {
    "VPN_WATCHDOG_DEMO": "1",
    "DJANGO_DEBUG": "0",
    "DJANGO_ALLOWED_HOSTS": ".vercel.app,.now.sh,localhost,127.0.0.1"
  }
}
